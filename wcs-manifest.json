{
  "title": "Road events",
  "shortName": "noi-a22-road-events",
  "description": "A responsive webcomponent for showing traffic events on Brennerlec A22 road",
  "descriptionAbstract": "A responsive webcomponent for showing traffic events on Brennerlec A22 road",
  "license": "AGPL-3.0-or-later",
  "repositoryUrl": "https://github.com/noi-techpark/webcomp-traffic-events.git",
  "copyrightHolders": [
    {
      "name": "NOI",
      "email": "info@noi.bz.it",
      "organization": "NOI S.p.A",
      "organizationUrl": "https://noi.bz.it"
    }
  ],
  "authors": [
    {
      "name": "NOI",
      "email": "digital@noi.bz.it",
      "organization": "NOI S.p.A",
      "organizationUrl": "https://noi.bz.it"
    },
    {
      "name": "Solhea",
      "email": "info@solhea.com",
      "organization": "Solhea S.R.L.",
      "organizationUrl": "https://solhea.com"
    }
  ],
  "image": "wcs-logo.png",
  "searchTags": [],
  "dist": {
    "basePath": "dist/bundle/noi-a22-road-events",
    "files": [
      "noi-a22-road-events.js",
      "data_a22-1km.json",
      "i18n_en.json",
      "i18n_it.json",
      "icon-accident.svg",
      "icon-animal-on-road.svg",
      "icon-caution.svg",
      "icon-closure.svg",
      "icon-congestion.svg",
      "icon-info.svg",
      "icon-hindrance.svg",
      "icon-maintenance.svg",
      "icon-mountaian-pass.svg",
      "icon-prohibition.svg",
      "icon-public-transport.svg",
      "icon-restiction.svg",
      "icon-road-condition.svg",
      "icon-road-work.svg",
      "icon-special.svg",
      "icon-speed-camera.svg",
      "icon-trail-closure.svg",
      "icon-weather-related.svg"
    ],
    "scripts": [
      {
        "file": "noi-a22-road-events.js",
        "parameter": "type='module'"
      }
    ]
  },
  "configuration": {
    "tagName": "noi-a22-road-events",
    "options": [
      {
        "key": "layout",
        "type": "select",
        "label": "Layout appearance",
        "required": false,
        "options": {
          "values": [
            "desktop",
            "tablet",
            "mobile",
            "auto"
          ],
          "default": "auto"
        }
      },
      {
        "key": "language",
        "type": "select",
        "label": "Two letter key for the language to be used, if omitted the widget will use the browser language. Fallback is `it`",
        "required": false,
        "options": {
          "values": [
            "en",
            "de",
            "it"
          ],
          "default": "it"
        }
      },
      {
        "key": "direction",
        "type": "select",
        "label": "Events direction filter",
        "required": false,
        "options": {
          "values": [
            "both",
            "north",
            "south"
          ],
          "default": "both"
        }
      },
      {
        "key": "style",
        "type": "text",
        "label": "CSS style definition",
        "required": false,
        "options": {
          "default": ""
        }
      }
    ]
  }
}
